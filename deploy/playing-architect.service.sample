# systemd user unit. deploy/deploy.sh fills @DIR@ (relative to $HOME) and @PORT@.
# Manual install: copy to ~/.config/systemd/user/playing-architect.service, then
#   systemctl --user daemon-reload && systemctl --user enable --now playing-architect.service
#   loginctl enable-linger "$USER"   # keep it running after logout
[Unit]
Description=playing-architect static site
After=network-online.target

[Service]
WorkingDirectory=%h/@DIR@
ExecStart=/usr/bin/python3 %h/@DIR@/.serve.py @PORT@
Restart=always

[Install]
WantedBy=default.target
